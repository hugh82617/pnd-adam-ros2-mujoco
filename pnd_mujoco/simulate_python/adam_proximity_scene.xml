<mujoco model="adam_pro proximity scene">

    <compiler
        angle="radian"
        meshdir="../../src/pnd_adam_description/meshes"
        texturedir="../../src/pnd_adam_description/meshes"/>


    <include file="../pnd_robots/adam_pro/adam_pro.xml"/>


    <option timestep="0.001"/>


    <visual>

        <global azimuth="160" elevation="-20"/>

        <headlight
            ambient="0.3 0.3 0.3"
            diffuse="0.6 0.6 0.6"
            specular="0 0 0"/>

    </visual>



    <asset>


        <texture
            type="skybox"
            builtin="gradient"
            rgb1="0.3 0.5 0.7"
            rgb2="0 0 0"
            width="512"
            height="3072"/>



        <texture
            type="2d"
            name="groundplane"
            builtin="checker"
            rgb1="0.2 0.3 0.4"
            rgb2="0.1 0.2 0.3"
            width="300"
            height="300"/>



        <material
            name="groundplane"
            texture="groundplane"
            texrepeat="5 5"
            reflectance="0.2"/>




        <!-- Human Arm Mesh -->
        <!-- 放大到约35cm -->
        <mesh
            name="human_arm"
            file="human_arm/untitled.obj"
            scale="0.0027 0.0027 0.0027"/>


    </asset>




    <worldbody>



        <!-- Ground -->

        <geom
            name="floor"
            size="10 10 0.05"
            type="plane"
            material="groundplane"/>




        <!-- Bed -->

        <geom
            name="bed_board"
            size="0.6 0.4 0.03"
            pos="2 0 0.2"
            type="box"
            rgba="0.8 0.7 0.6 1"/>



        <geom
            name="headboard"
            size="0.02 0.4 0.15"
            pos="1.4 0 0.35"
            type="box"
            rgba="0.6 0.5 0.4 1"/>



        <geom
            name="footboard"
            size="0.02 0.4 0.08"
            pos="2.6 0 0.25"
            type="box"
            rgba="0.6 0.5 0.4 1"/>




        <!-- Patient Forearm -->

        <!-- Patient Arm -->
<body
    name="patient_forearm"
    mocap="true"
    pos="0.8 -0.15 0.85"
    euler="-90 -90 -90">

    <geom
        name="patient_forearm_visual"
        type="mesh"
        mesh="human_arm"
        pos="0 0 0"
        rgba="0.85 0.85 0.85 1"
        contype="0"
        conaffinity="0"/>


    <geom
        name="patient_forearm_collision"
        type="capsule"
        fromto="0 0 -0.175 0 0 0.175"
        size="0.045"
        rgba="0 0 0 0"
        contype="1"
        conaffinity="1"/>


</body>




        <light
            pos="0 0 3.5"
            dir="0 0 -1"
            directional="true"/>



    </worldbody>



</mujoco>
